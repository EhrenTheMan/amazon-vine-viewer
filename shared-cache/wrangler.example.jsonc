{
  "name": "vine-etv-cache",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-16",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vine-etv-cache",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ],
  "ratelimits": [
    {
      "name": "LIMITER",
      "namespace_id": "REPLACE_WITH_RATE_LIMIT_NAMESPACE_ID",
      "simple": { "limit": 120, "period": 60 }
    }
  ]
}
